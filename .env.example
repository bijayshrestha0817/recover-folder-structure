# Which settings module to load: dev (default) or prod. See config/settings/.
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=secret_key
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (prod.py requires SECRET_KEY + ALLOWED_HOSTS, no insecure defaults):
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True   # set False if TLS is terminated upstream and already redirects
PG_SQL_ENGINE=django.db.backends.postgresql
PG_SQL_USER=dev_user
PG_SQL_PASSWORD=dev_password
PG_SQL_DATABASE=dev_db
PG_SQL_HOST=db
PG_SQL_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Set to True to run tasks inline without a worker (dev/debug); tests force this automatically.
CELERY_TASK_ALWAYS_EAGER=False
